# ===========================================================================
#  TRADING SYSTEM — ENVIRONMENT TEMPLATE
# ===========================================================================
#
#  SETUP
#    1. Copy this file to `.env`  (Windows: copy .env.example .env)
#    2. Fill in the values below.
#    3. Never commit `.env`. It is gitignored. Verify with: git check-ignore .env
#
#  SECURITY
#    - These credentials can place real orders and move real money.
#    - Do not paste them into chat, screenshots, issues, or source files.
#    - If you suspect exposure, regenerate the API key in the SmartAPI portal
#      and change your Angel One password + TOTP immediately.
#
# ===========================================================================


# ---------------------------------------------------------------------------
#  ANGEL ONE SMARTAPI CREDENTIALS  (all four are required)
# ---------------------------------------------------------------------------

# Trading API key from https://smartapi.angelone.in/ -> My Apps -> Trading API.
# Create a "Trading API" app (not Market Feed / Publisher) to get order rights.
ANGEL_API_KEY=

# Your Angel One login / client code, e.g. A123456 (uppercase letters + digits).
ANGEL_CLIENT_ID=

# Your Angel One *login PIN* (the MPIN/password used on the trading platform).
# Angel One's login endpoint calls this field "password".
ANGEL_PASSWORD=

# TOTP secret — the BASE32 string behind the authenticator QR code, NOT the
# 6-digit rotating code. Get it at: Angel One -> Profile -> Settings ->
# Enable TOTP. When shown the QR, choose "can't scan / enter manually" to
# reveal the secret. Typically 16-32 chars, A-Z and 2-7 only.
# The system generates the 6-digit code from this on every login.
ANGEL_TOTP_SECRET=


# ---------------------------------------------------------------------------
#  SERVER
# ---------------------------------------------------------------------------

# Bind address. Keep 127.0.0.1 (localhost only).
# This API exposes account balances, positions and order history, and from
# Phase 6 can place orders. Setting this to 0.0.0.0 publishes all of that to
# your entire network. Only do that behind a reverse proxy with TLS and auth.
API_HOST=127.0.0.1
API_PORT=8000

# Shared secret for the X-API-Key header. Leave blank to disable auth, which
# is only acceptable while bound to 127.0.0.1 on a single-user machine.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_KEY=

# Comma-separated CORS origins. "*" is convenient in development but combined
# with API_AUTH_KEY it lets any website in your browser read your account.
# Prefer an explicit list, or leave blank to disable CORS entirely.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------------------------------------------------------------------------
#  CACHE / POLLING
# ---------------------------------------------------------------------------

# Seconds between background cache refreshes. Below 2 you will hit SmartAPI
# rate limits. 5 is a sane default for polling-based (non-WebSocket) use.
CACHE_UPDATE_INTERVAL=5

# Cache is flagged STALE after this many seconds without a successful update.
# The charter forbids generating signals on data older than 60s.
CACHE_STALE_THRESHOLD=60

# Candle history depth kept warm in cache, per symbol per interval.
CACHE_CANDLE_BARS=200


# ---------------------------------------------------------------------------
#  RATE LIMITING (requests per second, per endpoint)
# ---------------------------------------------------------------------------
# Angel One publishes per-endpoint limits and returns "Access denied because
# of exceeding access rate" when breached. These defaults are deliberately
# conservative; raise them only against the current official rate-limit table.

RATE_LIMIT_QUOTE=1
RATE_LIMIT_LTP=8
RATE_LIMIT_CANDLE=3
RATE_LIMIT_ACCOUNT=1
RATE_LIMIT_ORDER=8


# ---------------------------------------------------------------------------
#  LOGGING
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# true = human-readable console lines, false = JSON lines (for shipping)
LOG_CONSOLE=true

# Directory for app.log / errors.log / trades.log (rotated, 10MB x 5)
LOG_DIR=logs


# ---------------------------------------------------------------------------
#  RISK PARAMETERS  (charter caps: 2% per trade, 5% daily, 10% weekly)
# ---------------------------------------------------------------------------
# Used by the position sizer from Phase 3 onward. Set them now so sizing is
# never guessed. Values above the charter ceilings are rejected at startup.

TOTAL_CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=2.0
MAX_WEEKLY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=3

# CONSERVATIVE | MODERATE | AGGRESSIVE
RISK_PROFILE=MODERATE

# SCALPING | INTRADAY | SWING | POSITIONAL
TRADING_STYLE=INTRADAY


# ---------------------------------------------------------------------------
#  OPTION PRICING
# ---------------------------------------------------------------------------
# Risk-free rate used to solve implied volatility and Greeks, as a decimal.
# Conventionally the 91-day T-bill yield. Worth updating when the rate moves:
# a stale rate biases every solved volatility, and the bias grows with tenor.
RISK_FREE_RATE=0.065


# ---------------------------------------------------------------------------
#  SIGNAL GENERATION  (Phase 4A)
# ---------------------------------------------------------------------------
# Thresholds for the spread candidate engine. This layer exists to reject, so
# the defaults are conservative on purpose. Loosening them does not create
# opportunities, it just lets through structures you cannot actually fill.

# Fraction of expected legs that must be present before a chain is trusted.
# A dropped quote batch looks identical to a genuinely empty strike.
SIGNAL_MIN_CHAIN_COVERAGE=0.85

# Widest acceptable bid-ask spread, as a PERCENT of the midpoint.
# 8.0 means eight percent. Every other _PCT setting here is also a percent.
SIGNAL_MAX_BID_ASK_SPREAD_PCT=8.0

# Minimum reward-to-risk after all charges. Not applied to single long options,
# whose upside is unbounded and whose ratio is therefore undefined.
SIGNAL_MIN_RISK_REWARD=1.5

# Expiry window. Below the floor, gamma and theta dominate and a small adverse
# move is unrecoverable. Above the ceiling is outside intraday and short swing.
SIGNAL_MIN_DAYS_TO_EXPIRY=2
SIGNAL_MAX_DAYS_TO_EXPIRY=14

# Largest share of maximum profit that transaction charges may consume.
# Brokerage is per order and does not scale down, so this bites hardest on the
# cheap spreads that a small budget can actually afford.
SIGNAL_MAX_COST_DRAG_PCT=50.0

# How many strike steps apart the two legs of a vertical may be.
SIGNAL_MAX_WIDTH_STEPS=4

# conservative | mid | bid | ask | ltp   (bidask is accepted for conservative)
# conservative is role-aware: the leg being bought is priced at the ask and the
# leg being sold at the bid, which is the side of each book you have to cross.
# mid is optimistic by roughly half the spread on every leg.
SIGNAL_PRICE_SOURCE=conservative

# Per-leg activity floors. Leave unset to not enforce them; the broker omits
# these fields for some strikes, and a missing value is not a zero value.
# SIGNAL_MIN_LEG_VOLUME=100
# SIGNAL_MIN_LEG_OPEN_INTEREST=500

# Must stay false until recorded option-chain history can validate a structure.
# While false, the engine's best action can never be BUY or SELL.
SIGNAL_ENABLE_UNBACKTESTED=false


# ---------------------------------------------------------------------------
#  TRADING MODE
# ---------------------------------------------------------------------------
# ANALYSIS | PAPER | LIVE
#   ANALYSIS — read-only. No order code path reachable. (Phase 1-3)
#   PAPER    — simulated fills against live prices. (Phase 5)
#   LIVE     — real orders. Requires LIVE_TRADING_ACKNOWLEDGED=true. (Phase 6)
# Leave as ANALYSIS. Phases 1-5 must pass their gates first.
TRADING_MODE=ANALYSIS

# Explicit, deliberate opt-in for real money. Startup refuses LIVE without it.
LIVE_TRADING_ACKNOWLEDGED=false


# ---------------------------------------------------------------------------
#  STATIC IP / SEBI ALGO COMPLIANCE  (Phase 6)
# ---------------------------------------------------------------------------
# Since 01-Apr-2026 Angel One only accepts API *order execution* from the
# static IP registered against your API key. Market-data calls are unaffected.
# If your ISP gives you a dynamic IP, route order traffic through a fixed-IP
# proxy and register the proxy's IP.
#
# Optional HTTPS proxy for outbound SmartAPI calls, e.g.
#   https://user:pass@proxy.example.com:9293
ANGEL_HTTPS_PROXY=

# Your registered static IP. Logged at startup so mismatches are obvious
# before an order is rejected. Informational only.
REGISTERED_STATIC_IP=


# ---------------------------------------------------------------------------
#  UPSTOX CREDENTIALS  (research only — historical data, never live trading)
# ---------------------------------------------------------------------------
# Upstox is purely a historical-data source for research/backtesting. Angel
# One remains the only broker anything in this repo places an order through.
# Leave these blank and the research layer degrades to UPSTOX_AUTH_UNAVAILABLE
# rather than attempting a doomed call.

# From https://developer.upstox.com/ -> your app's "API Key".
UPSTOX_CLIENT_ID=

# From the same app page -> "API Secret". Needed only for the one-time OAuth
# code exchange in core.upstox_auth; never sent on ordinary data calls.
UPSTOX_CLIENT_SECRET=

# Upstox access tokens are JWTs that expire daily (~3:30am IST) with no silent
# refresh-token renewal on the standard flow. There is no way to automate this
# away: complete core.upstox_auth's browser login once a day and paste the
# resulting token here. An expired value here surfaces as AUTH_ERROR, not
# UPSTOX_AUTH_UNAVAILABLE, since a present-but-stale token is a different
# failure than never having configured one.
UPSTOX_ACCESS_TOKEN=

# Must exactly match the redirect URI registered on the Upstox app (including
# scheme and trailing slash, if any). Used to build the authorization dialog
# URL and in the token-exchange request; not secret, just easy to typo.
UPSTOX_REDIRECT_URI=
